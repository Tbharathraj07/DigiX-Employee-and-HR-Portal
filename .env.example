# DigiX Technologies - Supabase Vite Environment Variables Template
# Copy this file to .env.local and populate with your credentials from Supabase Dashboard
# Project Settings -> API -> Project URL & Project API Keys (anon / publishable key)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
